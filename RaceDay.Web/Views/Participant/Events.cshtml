@model List<RaceDay.Web.Models.EventViewModel>
@{
    ViewData["Title"] = "Upcoming Events";
}

<h1>Upcoming Events</h1>

@if (TempData["Message"] != null)
{
    <div class="alert alert-info">@TempData["Message"]</div>
}

<table class="table">
    <thead>
        <tr>
            <th>Name</th>
            <th>Location</th>
            <th>Date</th>
            <th>Type</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var e in Model)
        {
            <tr>
                <td>@e.Name</td>
                <td>@e.Location</td>
                <td>@e.EventDate.ToString("yyyy-MM-dd")</td>
                <td>@e.EventType</td>
                <td><a class="btn btn-sm btn-primary" asp-action="Details" asp-route-id="@e.EventId">View</a></td>
            </tr>
        }
    </tbody>
</table>