@model List<RaceDay.Web.Controllers.ParticipantController.EnrolmentViewModel>
@{
    ViewData["Title"] = "My Enrolments";
}

<h1>My Enrolments</h1>

@if (TempData["Message"] != null)
{
    <div class="alert alert-info">@TempData["Message"]</div>
}

@if (Model == null || Model.Count == 0)
{
    <p>You have no enrolments yet.</p>
}
else
{
    <table class="table table-striped table-hover mt-4">
        <thead>
            <tr>
                <th>Enrolment ID</th>
                <th>Category ID</th>
                <th>Status</th>
                <th>Date</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var e in Model)
            {
                <tr>
                    <td>@e.EnrolmentId</td>
                    <td>@e.CategoryId</td>
                    <td>
                        @if (e.Status != null && e.Status.Equals("Confirmed", StringComparison.OrdinalIgnoreCase))
                        {
                            <span class="badge badge-confirmed">Confirmed</span>
                        }
                        else
                        {
                            <span class="badge badge-pending">@e.Status</span>
                        }
                    </td>
                    <td>@e.EnrolmentDate.ToString("yyyy-MM-dd")</td>
                </tr>
            }
        </tbody>
    </table>
}