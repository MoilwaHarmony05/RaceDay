@model List<RaceDay.Web.Controllers.ParticipantController.EnrolmentViewModel>
@{
    ViewData["Title"] = "My Enrolments";
}

<h1>My Enrolments</h1>

@if (TempData["Message"] != null)
{
    <div class="alert alert-info">@TempData["Message"]</div>
}

@if (Model.Count == 0)
{
    <p>You have no enrolments yet.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Enrolment ID</th>
                <th>Category ID</th>
                <th>Status</th>
                <th>Date</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var e in Model)
            {
                <tr>
                    <td>@e.EnrolmentId</td>
                    <td>@e.CategoryId</td>
                    <td>@e.Status</td>
                    <td>@e.EnrolmentDate.ToString("yyyy-MM-dd")</td>
                </tr>
            }
        </tbody>
    </table>
}