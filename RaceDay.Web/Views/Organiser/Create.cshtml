@model RaceDay.Web.Controllers.CreateEventDto

@{
    ViewData["Title"] = "Create Event";
}

<h1>Create Event</h1>

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger">@ViewBag.Error</div>
}

<form asp-action="Create" method="post">
    

    <div class="mb-3">
        <label asp-for="Name" class="form-label">Name</label>
        <input asp-for="Name" class="form-control" required />
    </div>

    <div class="mb-3">
        <label asp-for="Description" class="form-label">Description</label>
        <textarea asp-for="Description" class="form-control"></textarea>
    </div>

    <div class="mb-3">
        <label asp-for="Location" class="form-label">Location</label>
        <input asp-for="Location" class="form-control" required />
    </div>

    <div class="mb-3">
        <label asp-for="EventDate" class="form-label">Event date</label>
        <input asp-for="EventDate" type="datetime-local" class="form-control" required />
    </div>

    <div class="mb-3">
        <label asp-for="RegistrationDeadline" class="form-label">Registration deadline</label>
        <input asp-for="RegistrationDeadline" type="datetime-local" class="form-control" required />
    </div>

    <div class="mb-3">
        <label asp-for="Distance" class="form-label">Distance (km)</label>
        <input asp-for="Distance" type="number" step="0.1" class="form-control" required />
    </div>

    <div class="mb-3">
        <label asp-for="EventType" class="form-label">Event type</label>
        <select asp-for="EventType" class="form-control">
            <option value="Run">Run</option>
            <option value="Walk">Walk</option>
            <option value="Cycle">Cycle</option>
        </select>
    </div>

    <button type="submit" class="btn btn-primary mt-3">Create</button>
</form>