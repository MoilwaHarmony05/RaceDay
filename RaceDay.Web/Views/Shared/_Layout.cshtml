<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - RaceDay.Web</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/RaceDay.Web.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <ul class="navbar-nav flex-grow-1">
            <li class="nav-item">
                <a class="nav-link text-dark" asp-controller="Home" asp-action="Index">Home</a>
            </li>
            <li class="nav-item">
                <a class="nav-link text-dark" asp-controller="Organiser" asp-action="Dashboard">My Events</a>
            </li>
            @if (Context.Session.GetString("Role") == "Organiser")
            {
                <li class="nav-item">
                    <a class="nav-link text-dark" asp-controller="Organiser" asp-action="Dashboard">My Events</a>
                </li>
            }
            @if (Context.Session.GetString("Role") == "Participant")
            {
                <li class="nav-item">
                    <a class="nav-link text-dark" asp-controller="Participant" asp-action="Events">Browse Events</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link text-dark" asp-controller="Participant" asp-action="MyEnrolments">My Enrolments</a>
                </li>
            }
        </ul>
        <ul class="navbar-nav">
            @if (string.IsNullOrEmpty(Context.Session.GetString("Role")))
            {
                <li class="nav-item">
                    <a class="nav-link text-dark" asp-controller="Account" asp-action="Login">Login</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link text-dark" asp-controller="Account" asp-action="Register">Register</a>
                </li>
            }
            else
            {
                <li class="nav-item">
                    <span class="nav-link text-dark">@Context.Session.GetString("Email") (@Context.Session.GetString("Role"))</span>
                </li>
                <li class="nav-item">
                    <a class="nav-link text-dark" asp-controller="Account" asp-action="Logout">Logout</a>
                </li>
            }
        </ul>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - RaceDay.Web - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
