@model List<RaceDay.Web.Models.EventViewModel>
@{
    ViewData["Title"] = "Events";
}

<h1>Events</h1>

<table class="table">
    <thead>
        <tr>
            <th>Banner</th>
            <th>Name</th>
            <th>Location</th>
            <th>Date</th>
            <th>Type</th>
            <th>Status</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var e in Model)
        {
            <tr>
                <td>
                    @if (!string.IsNullOrEmpty(e.BannerImageUrl))
                    {
                        <img src="@e.BannerImageUrl" alt="@e.Name" style="max-width:100px;" />
                    }
                </td>
                <td>@e.Name</td>
                <td>@e.Location</td>
                <td>@e.EventDate.ToString("yyyy-MM-dd")</td>
                <td>@e.EventType</td>
                <td>@e.Status</td>
            </tr>
        }
    </tbody>
</table>